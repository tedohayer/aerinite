#!/bin/bash
# Run by aerinite-update-notify.path when an update is staged. Waits on the
# notification so its Restart button can open Noctalia's session menu, which
# asks for confirmation itself.
set -euo pipefail

version=$(rpm-ostree status --json | jq -r 'first(.deployments[] | select(.staged) | .version) // empty')
[ -n "${version}" ] || exit 0

action=$(notify-send --app-name=Aerinite --icon=system-software-update \
	--action=restart=Restart… \
	"Update ready" "Restart to use version ${version}")
if [ "${action}" = restart ]; then
	noctalia msg panel-open session
fi
