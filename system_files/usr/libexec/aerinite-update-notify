#!/bin/bash
# Update notifications. Their Restart… button opens Noctalia's session menu,
# which asks for confirmation itself.
#   staged: an update was just staged (aerinite-update-notify.path)
#   age:    the running build is over a month old (aerinite-update-age.timer),
#           so updates are failing or waiting on a restart
set -euo pipefail

MAX_AGE_DAYS=30

status=$(rpm-ostree status --json | jq -r '
	(first(.deployments[] | select(.staged) | .version) // ""),
	(first(.deployments[] | select(.booted) | .timestamp) // 0)')
staged=$(sed -n 1p <<< "${status}")
days=$(( ($(date +%s) - $(sed -n 2p <<< "${status}")) / 86400 ))

notify() {
	local icon=$1 action
	shift
	action=$(notify-send --app-name=Aerinite --icon="${icon}" "$@")
	if [ "${action}" = restart ]; then
		noctalia msg panel-open session
	fi
}

case "${1:-staged}" in
staged)
	[ -n "${staged}" ] || exit 0
	notify system-software-update --action=restart=Restart… \
		"Update ready" "Restart to use version ${staged}"
	;;
age)
	[ "${days}" -gt "${MAX_AGE_DAYS}" ] || exit 0
	if [ -n "${staged}" ]; then
		notify system-software-update --action=restart=Restart… \
			"Restart to update" "You're running a build from ${days} days ago. Restart to use version ${staged}."
	else
		notify dialog-warning \
			"Aerinite is out of date" "You're running a build from ${days} days ago. Updates may be failing; check rpm-ostree status."
	fi
	;;
esac
